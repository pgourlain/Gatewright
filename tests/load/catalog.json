{
  "format": "gatewright/v1",
  "config": {
    "version": 1,
    "products": [
      {
        "name": "load",
        "requiresSubscription": true
      }
    ],
    "apis": [
      {
        "name": "bare",
        "basePath": "/bare",
        "version": "v1",
        "backend": {
          "destinations": ["http://orders:8080"]
        }
      },
      {
        "name": "secured",
        "basePath": "/secured",
        "version": "v1",
        "backend": {
          "destinations": ["http://orders:8080"]
        },
        "policies": {
          "inbound": [
            {
              "type": "jwt",
              "config": {
                "required": true,
                "issuers": [
                  {
                    "issuer": "https://load.test",
                    "audiences": ["api://load"],
                    "jwksUri": "http://jwks:8080/jwks.json",
                    "refreshIntervalSeconds": 3600
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "name": "limited",
        "basePath": "/limited",
        "version": "v1",
        "products": ["load"],
        "backend": {
          "destinations": ["http://orders:8080"]
        },
        "policies": {
          "inbound": [
            {
              "type": "apiKey",
              "config": {
                "products": ["load"]
              }
            },
            {
              "type": "rateLimit",
              "config": {
                "limit": 2000,
                "periodSeconds": 10,
                "partitionBy": "subscription",
                "shared": true
              }
            }
          ]
        }
      },
      {
        "name": "cached",
        "basePath": "/cached",
        "version": "v1",
        "backend": {
          "destinations": ["http://orders:8080"]
        },
        "policies": {
          "inbound": [
            {
              "type": "cache",
              "config": {
                "durationSeconds": 10,
                "varyByQuery": []
              }
            }
          ]
        }
      }
    ]
  }
}
