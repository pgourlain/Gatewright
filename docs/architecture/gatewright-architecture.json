  "cards": [
    {
      "dot": "cyan",
      "title": "One binary, three modes",
      "items": [
        "Gateway:Mode selects all, control-plane or data-plane",
        "all mode replaces gRPC with an in-process channel",
        "all mode can also read a JSON config file instead of the database"
      ]
    },
    {
      "dot": "emerald",
      "title": "Request path",
      "items": [
        "No Kubernetes, control-plane or database call per request",
        "Without Redis, rate limits and revocations stay in memory"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "Admin API roles: Admin, Publisher, Reader",
        "Only the control plane reads the Kubernetes API"
      ]
    },
    {
      "dot": "amber",
      "title": "Gateway API (optional)",
      "items": [
        "Routes of a Gateway of class gatewright become APIs",
        "No product or policy: the API answers 503 api-not-configured",
        "Such an API is read-only in the Admin API until detached"
      ]
    }
